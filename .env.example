# Copy to .env and fill in real values. Never commit the real .env - it
# holds the two secrets (POSTGRES_PASSWORD, PASSWORD_PEPPER) that gate
# everything else.

# --- required ---

POSTGRES_PASSWORD=
# Generate with: openssl rand -base64 32
# Rotating this re-derives nothing automatically - it's mixed into every
# password hash and (as of the TOTP-secret-at-rest change) every encrypted
# TOTP seed. Losing it, or changing it without a migration plan, locks out
# every account. Back it up somewhere PASSWORD_PEPPER-worthy, not next to
# the database it protects if you can help it (see README's security notes
# on the pepper/database colocation tradeoff).
PASSWORD_PEPPER=

# Built from POSTGRES_PASSWORD automatically if you're using docker-compose;
# set explicitly if running the binary directly.
DATABASE_URL=postgres://hollowchat:${POSTGRES_PASSWORD}@localhost:5432/hollowchat

# Public URL clients (desktop app, browser extension, invite links) will
# reach this server at.
APP_BASE_URL=https://your-domain.example

# Comma-separated list of origins allowed to make cross-origin requests
# (e.g. a web client, or a browser extension's origin). Leave unset only if
# you're sure nothing but the desktop app talks to this server - an empty
# list means all cross-origin requests are rejected, which is the safe
# default, not a bug.
CORS_ALLOWED_ORIGINS=

# --- optional: voice/video calls ---
# Without a TURN server, calls between two people both behind restrictive
# NAT (most home/mobile connections) will frequently fail to connect.
# coturn is the common self-hosted option.
ICE_STUN_URLS=stun:stun.l.google.com:19302
ICE_TURN_URL=
ICE_TURN_USERNAME=
ICE_TURN_CREDENTIAL=

# --- optional: game cover art (SteamGridDB) ---
# Without this, only games whose own Rich Presence integration ships cover
# art, or ones covered by our bundled brand icons, show one.
STEAMGRIDDB_API_KEY=

# --- optional: billing (Lava) ---
LAVA_API_KEY=
LAVA_OFFER_ID=
# Offer ID of a "price on request via API" product, used for the one-off
# "support" payment where the buyer picks the amount. Leave unset to
# disable the /billing/donate endpoint.
LAVA_DONATE_OFFER_ID=
LAVA_WEBHOOK_SECRET=
LAVA_CURRENCY=

# --- optional: Web Push notifications ---
# Lets the web client show OS notifications for DMs / @mentions while the
# app is closed. Generate a VAPID keypair:
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
#   base64 -w0 vapid.pem          # -> VAPID_PRIVATE_KEY_B64
# Leave unset to disable push (endpoints still exist, they just no-op).
VAPID_PRIVATE_KEY_B64=
VAPID_SUBJECT=mailto:admin@example.com

# --- optional: Telegram alerts ---
# Server-health pings only (startup, database errors, panics) - not a
# notification system for users. Create a bot via @BotFather, message it
# once (or add it to a group/channel), then fetch
# https://api.telegram.org/bot<TOKEN>/getUpdates to read back the chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- optional: attachment retention ---
# Unset means "keep forever". When set, message/DM attachments older than
# this many days get their file bytes deleted on a background sweep
# (hourly) - the message stays, just shows as expired. Avatars, banners,
# server icons, custom emoji, and profile widget images are never swept,
# regardless of this setting.
ATTACHMENT_RETENTION_DAYS=

# --- optional: Bunny CDN for attachments ---
# All three must be set together, or all left unset (local disk storage).
# BUNNY_STORAGE_ZONE / BUNNY_STORAGE_API_KEY come from the storage zone's
# FTP & API Access page. BUNNY_CDN_BASE_URL is the Pull Zone's public
# hostname (its own b-cdn.net one, or a custom domain attached to it) -
# either way, no trailing slash.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_REGION_HOST=storage.bunnycdn.com
BUNNY_CDN_BASE_URL=

# --- rarely needed ---
BIND_ADDR=0.0.0.0:8080
ATTACHMENTS_DIR=./data/attachments
