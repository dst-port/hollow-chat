DATABASE_URL=postgres://hollowchat:password@localhost:5432/hollowchat
PASSWORD_PEPPER=change-me-to-a-long-random-value

# BIND_ADDR=127.0.0.1:8080
# ATTACHMENTS_DIR=./data/attachments
# APP_BASE_URL=http://127.0.0.1:1420

# lava.top billing (optional — /billing/checkout returns 503 until these are set)
# LAVA_API_KEY=
# LAVA_OFFER_ID=
# LAVA_WEBHOOK_SECRET=
# LAVA_CURRENCY=      # leave unset to let the buyer pick their currency at checkout

# Voice/video call ICE servers (used for WebRTC NAT traversal)
# ICE_STUN_URLS=stun:stun.l.google.com:19302   # comma-separated, defaults to Google's public STUN
# ICE_TURN_URL=turn:your-coturn-host:3478      # set this (and run your own coturn) to avoid a third-party STUN server seeing peer IPs
# ICE_TURN_USERNAME=
# ICE_TURN_CREDENTIAL=
