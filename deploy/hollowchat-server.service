[Unit]
Description=HollowChat server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=hollowchat
Group=hollowchat
WorkingDirectory=/opt/hollowchat
EnvironmentFile=/opt/hollowchat/.env
ExecStart=/opt/hollowchat/hollowchat-server
Restart=on-failure
RestartSec=2

# Hardening - the process needs its own working directory (attachments) and
# outbound network (Discord CDN, SteamGridDB, TURN, billing webhooks), and
# nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hollowchat/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
